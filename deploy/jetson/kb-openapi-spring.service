# Jetson(jetson@192.168.35.41)용 systemd 서비스: Spring 서버를 9080 포트로 계속 실행합니다.
# GitHub Actions self-hosted runner가 main push 뒤 deploy/jetson/deploy.sh로 이 서비스를 다시 시작합니다 (.github/workflows/deploy-jetson.yml).
#   sudo cp deploy/jetson/kb-openapi-spring.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kb-openapi-spring
#   journalctl -u kb-openapi-spring -f      # 로그
[Unit]
Description=KB OpenAPI (Spring Boot, Jetson)
After=network-online.target
Wants=network-online.target

[Service]
User=jetson
WorkingDirectory=/home/jetson/yang/MyProject_Yang_01/spring-app
Environment=KB_DATA_DIR=/home/jetson/yang/MyProject_Yang_01
Environment=PORT=9080
Environment=LANG=en_US.UTF-8
# 코드·화면이 jar보다 새로우면 다시 빌드 (deploy.sh가 먼저 빌드하므로 보통은 바로 끝남). '-': 빌드가 실패해도 기존 jar로 시작
ExecStartPre=-/home/jetson/yang/MyProject_Yang_01/spring-app/run.sh prepare
TimeoutStartSec=600
ExecStart=/usr/bin/java -XX:SharedArchiveFile=target/app/app.jsa -XX:TieredStopAtLevel=1 -jar target/app/kb-openapi-spring.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
