  "cards": [
    {
      "dot": "cyan",
      "title": "C로 읽는 법",
      "items": [
        "class = struct + 함수, new = malloc (free 없음)",
        "Map<String,Object> = JSON 객체 (해시 테이블)",
        "throw / catch = longjmp / setjmp"
      ]
    },
    {
      "dot": "amber",
      "title": "스레드와 락",
      "items": [
        "app_do_get()은 여러 스레드에서 동시에 호출",
        "access_token()은 synchronized = mutex",
        "캐시는 ConcurrentHashMap = 락 내장 해시"
      ]
    }
  ]
