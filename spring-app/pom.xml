<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot 버전 (내장 Tomcat, 실행 JAR 하나).
    mvn -q package                     -> target/kb-openapi-spring.jar
    java -jar target/kb-openapi-spring.jar

  핵심 로직(KBClient, Heatmap, Dividends)은 ../java-app/src/main/java를 함께 컴파일해 그대로 씁니다.
  화면(HTML)은 저장소 루트의 home.html, heatmap.html, me.html을 static/에 넣습니다.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>kb</groupId>
  <artifactId>kb-openapi-spring</artifactId>
  <version>1.0</version>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- java-app의 .kt (Kotlin·Java 혼합, 버전은 Spring Boot가 관리: 1.9.25) -->
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <!-- Volume·Russell의 KB 동시 조회 (Values.parallelIO). 버전은 Spring Boot가 관리 -->
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- KBClient가 KB 응답을 읽을 때 씁니다 (버전은 Spring Boot가 관리). -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <!-- 내정보를 하루 한 번만 조회해 저장하는 kb.db (DailyStore). 버전은 Spring Boot가 관리 (3.49.1.0). -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <!-- 보유 금액 4시간 기록 (Snapshots, MYSQL_HOST가 있을 때만 접속). 버전은 Spring Boot가 관리 (9.7.0). -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>kb-openapi-spring</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>static</targetPath>
        <includes>
          <include>home.html</include>
          <include>heatmap.html</include>
          <include>me.html</include>
          <include>chart.html</include>
          <include>volume.html</include>
          <include>trader.html</include>
          <include>signals.js</include>
          <include>sw.js</include>
        </includes>
      </resource>
      <!-- 첫 화면의 '구조 문서': Archify 구조도·순서도 → /docs/*.html (검증용 *.visual-check.html 제외) -->
      <resource>
        <directory>${project.basedir}/../docs</directory>
        <targetPath>static/docs</targetPath>
        <includes>
          <include>*.html</include>
        </includes>
        <excludes>
          <exclude>*.visual-check.html</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>shared-core</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../java-app/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Kotlin을 먼저 컴파일(Java 소스도 읽음)하고, 그다음 Java를 컴파일. jvmTarget은 Spring Boot가 java.version으로 맞춤 -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>compile</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <sourceDirs>
                <sourceDir>${project.basedir}/src/main/java</sourceDir>
                <sourceDir>${project.basedir}/../java-app/src/main/java</sourceDir>
              </sourceDirs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution><id>default-compile</id><phase>none</phase></execution>
          <execution><id>default-testCompile</id><phase>none</phase></execution>
          <execution><id>java-compile</id><phase>compile</phase><goals><goal>compile</goal></goals></execution>
          <execution><id>java-test-compile</id><phase>test-compile</phase><goals><goal>testCompile</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
